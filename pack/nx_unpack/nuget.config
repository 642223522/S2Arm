<?xml version="1.0" encoding="utf-8"?>
<!-- 读取器的 NuGet 源。LibHac 预发布包与 ZstdSharp.Port 只取仓内 compat/packages（来源映射钉死，不会从网上换掉）。
     其余（NativeAOT 发布要的 Microsoft.DotNet.ILCompiler、runtime.<rid>.Microsoft.DotNet.ILCompiler、Microsoft.NETCore.App.Runtime(.NativeAOT).<rid>、
     Microsoft.NET.ILLink.Tasks 等 SDK 按版本现取的包）走 nuget.org：读取器随发版编成 NativeAOT 单文件（launchers/macos/bundle_engine.py、pack/jobs/toolchain.py），
     只留本地源时 NuGet 缓存为空的发版机 / 新机器 restore 必红（NU1101）。这批包按 SDK 版本走、解开后单个约 90–135 MB（10.0.14：运行时包 135 MB、NativeAOT 运行时包 89 MB），不收进仓库（同根目录 nuget.config、services/nuget.config 的做法）。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="s2arm-ryujinx" value="../../compat/packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="s2arm-ryujinx">
      <package pattern="Ryujinx.LibHac" />
      <package pattern="ZstdSharp.Port" />
    </packageSource>
  </packageSourceMapping>
</configuration>
