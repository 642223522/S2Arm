<!-- 门禁手动：手动核 JIT / NativeAOT 两条路径（services/README.md）；门禁跑同一测试的服务单测独立模式 --filesystem-restart（随 services/test.sh 那次编译），不再单独编本工程 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <PublishAot Condition="'$(S2AFsAot)' == '1'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../S2A.Services.Tests/FileSystemRestart.cs" />
    <ProjectReference Include="../../compat/tree/src/Ryujinx.HLE/Ryujinx.HLE.csproj" />
  </ItemGroup>
</Project>
