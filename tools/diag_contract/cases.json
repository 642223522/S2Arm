{
  "about": "诊断收件契约的共用用例表：S2Arm 门禁（tests/diag_contract_test.sh，Python 解释器）与收件 Worker 单测（JS 解释器、真实 fetch 入口）都跑这一份。期望照规则手写，不跑实现推算。每例一个只存不压的包：缺省先放 manifest.json = {\"schema\": 1}（\"manifest\": null 不放、给字符串就用它当内容），再放 files；文件内容缺省为 size 个 x，text 给定就用它；n 份时名字里的 {i} 换成 0..n-1；link 为真记成符号链接。want = ok 或第一条错误码（同 Worker 回的 error）",
  "cases": [
    {"what": "logs/ 下日志", "files": [{"name": "logs/host.log", "size": 10}], "want": "ok"},
    {"what": "根上的日志", "files": [{"name": "host.log", "size": 10}], "want": "ok"},
    {"what": "任务记录 jobs/<任务>.txt", "files": [{"name": "jobs/0b7f5c1e-1111-2222-3333-444455556666.txt", "size": 10}], "want": "ok"},
    {"what": "多层目录下的表格", "files": [{"name": "phone/logs/sub/frames.tsv", "size": 10}], "want": "ok"},
    {"what": "崩溃报告 .ips", "files": [{"name": "mac_crash/S2Arm-2026-11-16-120000.ips", "size": 10}], "want": "ok"},
    {"what": "大写扩展名的截图", "files": [{"name": "diagrun/app_SHOT.PNG", "size": 10}], "want": "ok"},
    {"what": "管线记录 pso/<号>.tsv", "files": [{"name": "pso/0100000000010000.tsv", "size": 10}], "want": "ok"},
    {"what": "着色器补料：大写程序号 .tar", "files": [{"name": "shader_miss/0400486024DEC000.tar", "size": 10}], "want": "ok"},
    {"what": "着色器现场 .inflight.ctl 正好 1 MB", "files": [{"name": "shaders/0400A3A01EE4C000_4ee9c7bcd56c0ab3.inflight.ctl", "size": 1048576}], "want": "ok"},
    {"what": "着色器现场 .fail.code", "files": [{"name": "shaders/0400A3A01EE4C000_4ee9c7bcd56c0ab3.fail.code", "size": 10}], "want": "ok"},
    {"what": "慢管线 .slow.metal 正好 4 MB", "files": [{"name": "shaders/0400A3A01EE4C000_4ee9c7bcd56c0ab3_b.slow.metal", "size": 4194304}], "want": "ok"},
    {"what": "MetricKit JSON", "files": [{"name": "metrickit/crash-1.json", "size": 10}], "want": "ok"},
    {"what": "唯一一层包装目录", "manifest": null, "files": [{"name": "S2Arm-diag/manifest.json", "text": "{\"schema\": 1}"}, {"name": "S2Arm-diag/logs/a.log", "size": 10}], "want": "ok"},
    {"what": "着色器现场正好 32 份（ctl 16 + metal 16）", "files": [{"name": "shaders/k{i}.fail.ctl", "size": 1, "n": 16}, {"name": "shaders/k{i}.slow.metal", "size": 1, "n": 16}], "want": "ok"},
    {"what": "着色器现场 33 份", "files": [{"name": "shaders/k{i}.fail.ctl", "size": 1, "n": 17}, {"name": "shaders/k{i}.slow.metal", "size": 1, "n": 16}], "want": "too_many_files"},
    {"what": "单个成员正好 16 MB", "files": [{"name": "logs/big.log", "size": 16777216}], "want": "ok"},
    {"what": "单个成员超 16 MB", "files": [{"name": "logs/big.log", "size": 16777217}], "want": "file_too_large"},
    {"what": ".ctl 超 1 MB", "files": [{"name": "shaders/k.fail.ctl", "size": 1048577}], "want": "file_too_large"},
    {"what": ".slow.metal 截断成品：1 MB + 截断标记 + 3 MB（客户端实发）", "files": [{"name": "shaders/k_b.slow.metal", "size": 4194335}], "want": "ok"},
    {"what": ".slow.metal 正好 4 MB + 64 KB", "files": [{"name": "shaders/k_b.slow.metal", "size": 4259840}], "want": "ok"},
    {"what": ".slow.metal 超 4 MB + 64 KB", "files": [{"name": "shaders/k_b.slow.metal", "size": 4259841}], "want": "file_too_large"},
    {"what": "压缩后超 30 MB", "files": [{"name": "logs/a{i}.log", "size": 15728640, "n": 2}], "want": "too_large"},
    {"what": "别的目录下的 .metal", "files": [{"name": "logs/x.metal", "size": 10}], "want": "forbidden_file"},
    {"what": "shaders 下多一层目录", "files": [{"name": "shaders/sub/k.fail.ctl", "size": 10}], "want": "forbidden_file"},
    {"what": "目录名大小写不同的 Shaders/", "files": [{"name": "Shaders/k.fail.ctl", "size": 10}], "want": "forbidden_file"},
    {"what": "shader_miss 下名字不是 16 位程序号", "files": [{"name": "shader_miss/abc.tar", "size": 10}], "want": "forbidden_file"},
    {"what": "shader_miss 下 15 位程序号", "files": [{"name": "shader_miss/0400486024DEC00.tar", "size": 10}], "want": "forbidden_file"},
    {"what": "shader_miss 下多一层目录", "files": [{"name": "shader_miss/x/0400486024DEC000.tar", "size": 10}], "want": "forbidden_file"},
    {"what": "别的目录下的 .tar", "files": [{"name": "logs/0400486024DEC000.tar", "size": 10}], "want": "forbidden_file"},
    {"what": "可执行文件", "files": [{"name": "logs/a.exe", "size": 10}], "want": "forbidden_file"},
    {"what": "没有扩展名", "files": [{"name": "logs/README", "size": 10}], "want": "forbidden_file"},
    {"what": "点开头的文件名（不算扩展名）", "files": [{"name": "logs/.log", "size": 10}], "want": "forbidden_file"},
    {"what": "keys/ 目录", "files": [{"name": "keys/prod.txt", "size": 10}], "want": "forbidden_file"},
    {"what": "大小写不同的 Saves/ 目录", "files": [{"name": "Saves/a.log", "size": 10}], "want": "forbidden_file"},
    {"what": "games/ 目录", "files": [{"name": "games/0100000000010000/unpack.log", "size": 10}], "want": "forbidden_file"},
    {"what": "resources/ 目录", "files": [{"name": "resources/a.json", "size": 10}], "want": "forbidden_file"},
    {"what": "大写 .KEYS", "files": [{"name": "logs/title.KEYS", "size": 10}], "want": "forbidden_file"},
    {"what": "路径带 ..", "files": [{"name": "logs/../a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "绝对路径", "files": [{"name": "/a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "反斜杠", "files": [{"name": "logs\\a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "盘符", "files": [{"name": "C:a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "空段", "files": [{"name": "logs//a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "符号链接", "files": [{"name": "logs/l.log", "size": 10, "link": true}], "want": "unsafe_path"},
    {"what": "重名", "files": [{"name": "logs/a.log", "size": 10}, {"name": "logs/a.log", "size": 10}], "want": "unsafe_path"},
    {"what": "缺 manifest.json", "manifest": null, "files": [{"name": "logs/a.log", "size": 10}], "want": "not_diag"},
    {"what": "manifest schema 不是 1", "manifest": "{\"schema\": 2}", "files": [], "want": "not_diag"},
    {"what": "manifest schema 是 true", "manifest": "{\"schema\": true}", "files": [], "want": "not_diag"},
    {"what": "manifest 不是对象", "manifest": "[1]", "files": [], "want": "not_diag"}
  ]
}
