 pub const DEFAULT_ANISETTE_URL_V3: &str = "https://mac-ani.jkcoxson.com";
 
+// S2Arm: the default v3 server reports "<Mac OS X;10.12.6>" as X-Mme-Client-Info and Apple rejects some accounts with
+// "-23782 A Mac with macOS 10.13 or later is required". Switching servers for everyone would expire every saved session
+// (Apple ties sessions to the anisette server), so the fallback is used only after that rejection and is then remembered
+// per data folder in V3_URL_FILE. ani.sidestore.io reports macOS 13.1.
+pub const FALLBACK_ANISETTE_URL_V3: &str = "https://ani.sidestore.io";
+pub const V3_URL_FILE: &str = "anisette-v3-url";
+
+/// S2Arm: provisioning state file for a v3 server ("state.plist" for the default one)
+pub fn state_file_name(url: &str) -> String {
+    if url.trim_end_matches('/') == DEFAULT_ANISETTE_URL_V3 {
+        return "state.plist".to_string();
+    }
+    let host: String = url.split("://").last().unwrap_or(url).trim_end_matches('/')
+        .chars().map(|c| if c.is_ascii_alphanumeric() || c == '.' || c == '-' { c } else { '_' }).collect();
+    format!("state-{host}.plist")
+}
