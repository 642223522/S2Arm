+/// S2Arm: log in on the data folder's anisette v3 server; "-23782 A Mac with macOS 10.13 or later is required" there →
+/// remember the fallback server for this data folder (omnisette FALLBACK_ANISETTE_URL_V3), log one line, retry once on it.
+/// `attempt` logs in once with the given configuration (tests pass a fake).
+pub async fn login_with_anisette_fallback<T, A, Fut>(
+    config: AnisetteConfiguration,
+    who: impl Fn() -> String,
+    attempt: A,
+) -> Result<T, Error>
+where
+    A: Fn(AnisetteConfiguration) -> Fut,
+    Fut: std::future::Future<Output = Result<T, Error>>,
+{
+    let from = config.effective_anisette_url_v3();
+    match attempt(config.clone()).await {
+        Err(Error::AuthSrpWithMessage(-23782, msg)) if config.switch_to_fallback_v3() => {
+            log::warn!(
+                "S2Arm anisette fallback: account {} rejected on {} (SRP -23782: {}); switching this data folder to {} and retrying",
+                who(), from, msg, omnisette::FALLBACK_ANISETTE_URL_V3
+            );
+            attempt(config).await
+        }
+        r => r,
+    }
+}
